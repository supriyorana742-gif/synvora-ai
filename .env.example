# Public site URL (used for metadata, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details shown on the site. Replace once your domain is live.
NEXT_PUBLIC_CONTACT_EMAIL=hello@YOUR-DOMAIN.com
NEXT_PUBLIC_CONTACT_PHONE=+91 7219687310
NEXT_PUBLIC_WHATSAPP_NUMBER=+917219687310
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# --- Lead storage (Supabase) -------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (Resend) --------------------------------------------
# Server-only. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Synvora AI <inquiries@YOUR-DOMAIN.com>
CONTACT_TO_EMAIL=

# --- Spam protection (optional, Cloudflare Turnstile) ------------------------
# If both are set, Turnstile is enforced on the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
